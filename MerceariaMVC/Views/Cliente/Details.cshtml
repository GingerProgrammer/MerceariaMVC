@model MerceariaMVC.Models.Cliente

@{
    ViewData["Title"] = "Detalhes do Cliente";
}

<div class="page-header">
    <div>
        <span class="section-label">CLIENTES</span>
        <h1>Detalhes do cliente</h1>
        <p>Confira as informações cadastradas.</p>
    </div>
</div>

<div class="panel details-panel">
    <div class="details-icon">👤</div>

    <div class="details-content">
        <div class="detail-item">
            <span class="detail-label">Nome</span>
            <span class="detail-value">@Html.DisplayFor(model => model.Nome)</span>
        </div>

        <div class="detail-item">
            <span class="detail-label">Email</span>
            <span class="detail-value">@Html.DisplayFor(model => model.Email)</span>
        </div>

        <div class="detail-item">
            <span class="detail-label">Idade</span>
            <span class="detail-value">@Html.DisplayFor(model => model.Idade)</span>
        </div>

        <div class="detail-item">
            <span class="detail-label">Status</span>
            <span class="detail-value">
                @if (Model.Ativo)
                {
                    <span class="badge good">Ativo</span>
                }
                else
                {
                    <span class="badge warning">Inativo</span>
                }
            </span>
        </div>
    </div>

    <div class="form-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="primary-btn">Editar cliente</a>
        <a asp-action="Index" class="ghost-btn">Voltar</a>
    </div>
</div>